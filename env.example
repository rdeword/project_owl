# Telegram Bot Tokens
MAIN_BOT_TOKEN=your_main_bot_token_here
TEST_USER_BOT_1=your_test_bot_1_token_here
TEST_USER_BOT_2=your_test_bot_2_token_here

# Telegram API (для Telethon)
TELEGRAM_API_ID=your_api_id_here
TELEGRAM_API_HASH=your_api_hash_here

# Database
DATABASE_URL=postgresql://postgres:password@db:5432/news_aggregator
# Для локальной разработки: sqlite:///./news_aggregator.db

# Redis (для кэширования)
REDIS_URL=redis://redis:6379/0

# OpenAI API (для ИИ)
OPENAI_API_KEY=your_openai_api_key_here

# Web App URL
WEBAPP_URL=http://localhost:8000/webapp
# Для продакшена: https://yourdomain.com/webapp

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/app.log

# Security
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=10
